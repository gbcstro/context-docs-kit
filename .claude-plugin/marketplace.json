{
  "name": "context-docs-kit",
  "owner": {
    "name": "Gabriel Castro"
  },
  "allowCrossMarketplaceDependenciesOn": [
    "superpowers-marketplace",
    "ponytail",
    "mattpocock",
    "anthropic-agent-skills",
    "taste-skill",
    "impeccable",
    "caveman"
  ],
  "plugins": [
    {
      "name": "context-docs-kit",
      "source": "./",
      "version": "2.2.0",
      "description": "Four skills that build and maintain a project's context/ foundation docs: bootstrapping-context-docs interviews you into a doc set, aligning-context-docs pulls the docs back in line with the code, versioning-context-docs closes one version and opens the next, and upgrading-context-docs moves an existing project onto the newest kit.",
      "license": "MIT",
      "homepage": "https://github.com/gbcstro/context-docs-kit",
      "dependencies": [
        {
          "name": "superpowers",
          "marketplace": "superpowers-marketplace"
        },
        {
          "name": "ponytail",
          "marketplace": "ponytail"
        },
        {
          "name": "mattpocock-skills",
          "marketplace": "mattpocock"
        },
        {
          "name": "example-skills",
          "marketplace": "anthropic-agent-skills"
        },
        {
          "name": "taste-skill",
          "marketplace": "taste-skill"
        },
        {
          "name": "impeccable",
          "marketplace": "impeccable"
        },
        {
          "name": "caveman",
          "marketplace": "caveman"
        }
      ]
    }
  ]
}
